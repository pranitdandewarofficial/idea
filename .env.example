# ---------------------------------------------------------------------------
# PRANIT AI CITY - environment template
#
# Copy to `backend/.env` (or export these in your shell). Every value below is
# optional: the defaults are the safe ones. NOTHING HERE IS A SECRET, and no
# real credential belongs in this file - provider API keys are entered through
# the UI (AI Providers) or POST /api/providers, and are encrypted with Fernet
# before they are written to SQLite.
#
# Prefix rule: every setting is read as PRANIT_<UPPER_SNAKE_CASE>.
# ---------------------------------------------------------------------------

# --- network ---------------------------------------------------------------
# Localhost only. The API is never meant to be reachable from another machine;
# the frontend dev server proxies /api and /ws to it.
PRANIT_HOST=127.0.0.1
PRANIT_PORT=8000
# Origins allowed to call the API from a browser (the Vite dev server + a local
# production preview). Add nothing else unless you understand the consequence.
PRANIT_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173"]

# --- auth ------------------------------------------------------------------
# Bearer token required on every /api route except /api/health and
# /api/setup/status (the local first-run bootstrap).
# Leave empty to generate one at boot; it is written to .data/api_token (0600)
# and printed once in the server log.
PRANIT_API_TOKEN=
PRANIT_AUTH_ENABLED=true

# Fernet key used to encrypt provider API keys at rest. Leave empty to generate
# one into .data/secret_key (0600). If you set it yourself, keep it out of git:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes every stored provider key unreadable (re-enter them).
PRANIT_SECRET_KEY=

# --- storage ---------------------------------------------------------------
# Both default to <repo>/.data and <repo>/workspaces.
PRANIT_DATA_DIR=
PRANIT_WORKSPACES_DIR=
# Defaults to sqlite:///<data_dir>/pranit.db with WAL journaling.
PRANIT_DB_URL=

# --- spend -----------------------------------------------------------------
# HARD DEFAULT. While true, any provider flagged is_paid is refused at the
# registry level unless a specific run was submitted with spend_authorized=true.
PRANIT_ZERO_SPEND=true
PRANIT_PLAN_TOKEN_BUDGET=400000
PRANIT_GLOBAL_TOKEN_BUDGET=2000000
PRANIT_PROVIDER_REQUEST_TIMEOUT=120.0

# --- execution limits (the reason a run cannot loop forever) ---------------
PRANIT_MAX_CONCURRENCY=4
PRANIT_MAX_TASKS_PER_AGENT=1
PRANIT_MAX_PLAN_TASKS=25
PRANIT_TASK_TIMEOUT_SECONDS=600
PRANIT_SHELL_TIMEOUT_SECONDS=120
PRANIT_AGENT_TOOL_ROUNDS=6
PRANIT_MAX_REPAIRS=2

# --- sandbox ---------------------------------------------------------------
# 1 = subprocess with resource limits and a scrubbed environment (default)
# 2 = one Docker container per project (requires a working docker CLI)
PRANIT_SANDBOX_TIER=1
PRANIT_DOCKER_IMAGE=python:3.12-slim

# --- approvals -------------------------------------------------------------
# 0 = wait indefinitely for a human decision (recommended).
PRANIT_APPROVAL_TIMEOUT_SECONDS=0
PRANIT_AUTO_APPROVE_LOW_RISK=true
PRANIT_LOW_RISK_THRESHOLD=0.4

# --- System 1 decision layer ----------------------------------------------
PRANIT_DECISIONS_ENABLED=true
# auto        = use Laya when a runtime is importable, else the local engine
# laya        = require the PyTorch `laya` package
# laya_mnn    = require the `laya-mnn` runtime (~50 ms CPU)
# laya_hosted = call a remote Laya-compatible endpoint (set PRANIT_LAYA_BASE_URL)
# local       = deterministic built-in engine (no download, no network)
# llm         = answer every decision with the configured language model
PRANIT_DECISION_MODE=auto
PRANIT_DECISION_CONFIDENCE_THRESHOLD=0.85
PRANIT_DECISION_FALLBACK_TO_LLM=true
PRANIT_DECISION_MAX_STATE_CHARS=6000
PRANIT_LAYA_MODEL=convaiinnovations/laya
PRANIT_LAYA_BASE_URL=
PRANIT_LAYA_API_KEY=
PRANIT_LAYA_PRECISION=fp16
PRANIT_LAYA_THREADS=4

# --- preview servers started from the UI -----------------------------------
# Optional template for a reachable preview URL, e.g. for a sandbox/tunnel:
#   PRANIT_PUBLIC_URL_TEMPLATE=https://{port}-myhost.example.app
# Leave empty and only http://127.0.0.1:<port> is reported.
PRANIT_PUBLIC_URL_TEMPLATE=

# --- frontend (Vite) -------------------------------------------------------
# Where the dev server proxies /api and /ws. Not a browser-visible URL.
PRANIT_BACKEND=http://127.0.0.1:8000
PORT=5173
